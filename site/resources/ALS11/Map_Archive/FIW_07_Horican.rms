create_elevation 4 { base_terrain ROAD2 number_of_clumps	9320 set_scale_by_groups number_of_tiles 100000 enable_balanced_elevation }

/* Elevating Some Islands */
create_elevation 3 { base_terrain PHT10 number_of_clumps 2 set_scale_by_groups if TINY_MAP number_of_tiles 576 elseif SMALL_MAP number_of_tiles 864 elseif MEDIUM_MAP number_of_tiles 1152 elseif LARGE_MAP number_of_tiles 1646 elseif HUGE_MAP number_of_tiles 1975 else number_of_tiles 2386 endif enable_balanced_elevation }

/* Elevating Downstream */
create_elevation 2 { base_terrain PHT5 number_of_clumps 6 set_scale_by_groups if TINY_MAP number_of_tiles 57 elseif SMALL_MAP number_of_tiles 86 elseif MEDIUM_MAP number_of_tiles 115 elseif LARGE_MAP number_of_tiles 164 elseif HUGE_MAP number_of_tiles 197 else number_of_tiles 238 endif enable_balanced_elevation }

/* Elevating Interparabolic Fill */
create_elevation 4 { base_terrain PHT4 number_of_clumps 20 set_scale_by_groups if TINY_MAP number_of_tiles 576 elseif SMALL_MAP number_of_tiles 864 elseif MEDIUM_MAP number_of_tiles 1152 elseif LARGE_MAP number_of_tiles 1646 elseif HUGE_MAP number_of_tiles 1975 else number_of_tiles 2386 endif enable_balanced_elevation }

/* Elevating Banks 1 */
create_elevation 5 { base_terrain PHT7 number_of_clumps 20 set_scale_by_groups if TINY_MAP number_of_tiles 576 elseif SMALL_MAP number_of_tiles 864 elseif MEDIUM_MAP number_of_tiles 1152 elseif LARGE_MAP number_of_tiles 1646 elseif HUGE_MAP number_of_tiles 1975 else number_of_tiles 2386 endif enable_balanced_elevation }

/* Elevating Banks 2 */
create_elevation 6 { base_terrain PHT8 number_of_clumps 20 set_scale_by_groups if TINY_MAP number_of_tiles 576 elseif SMALL_MAP number_of_tiles 864 elseif MEDIUM_MAP number_of_tiles 1152 elseif LARGE_MAP number_of_tiles 1646 elseif HUGE_MAP number_of_tiles 1975 else number_of_tiles 2386 endif enable_balanced_elevation }

/* Elevating Banks 3 */
create_elevation 7 { base_terrain PHT9 number_of_clumps 20 set_scale_by_groups if TINY_MAP number_of_tiles 576 elseif SMALL_MAP number_of_tiles 864 elseif MEDIUM_MAP number_of_tiles 1152 elseif LARGE_MAP number_of_tiles 1646 elseif HUGE_MAP number_of_tiles 1975 else number_of_tiles 2386 endif enable_balanced_elevation }

