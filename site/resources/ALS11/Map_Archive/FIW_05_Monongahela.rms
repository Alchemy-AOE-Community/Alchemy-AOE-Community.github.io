        start_random
            percent_chance 10 other_zone_avoidance_distance rnd(2,5)
            percent_chance 70 other_zone_avoidance_distance rnd(1,3)
            percent_chance 20 other_zone_avoidance_distance rnd(1,2)
        end_random
    else
        other_zone_avoidance_distance 4 /* TODO reduce down to a single tile as specs say? decide later */
    endif
}
