/* potential changes: could make a land in the center that the lands connect to: might be better that way even. If I need to add a corner village, than corner lands would need to be on a terrain with a terrain cost of 0.
*/

accumulate_connections

create_connect_all_players_land 
{
    replace_terrain MAIN_TERRAIN MAIN_FOREST 
    terrain_cost PLAYER_FOREST 0
    terrain_cost MAIN_TERRAIN 4
    terrain_cost VILLAGE_TERRAIN 15
    terrain_size MAIN_TERRAIN 6 0
}
create_connect_all_players_land 
{
    replace_terrain MAIN_FOREST TUNNEL_TERRAIN 
    terrain_cost MAIN_FOREST 4
    terrain_cost MAIN_TERRAIN 0
    terrain_cost VILLAGE_TERRAIN 15
    terrain_size MAIN_FOREST 4 0
}
