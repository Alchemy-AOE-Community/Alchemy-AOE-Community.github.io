{
    replace_terrain TUNNEL_TERRAIN  BRADDOCK_ROAD
    replace_terrain VILLAGE_TERRAIN BRADDOCK_ROAD
    terrain_cost TUNNEL_TERRAIN 2
    terrain_cost MAIN_FOREST 0
    terrain_cost MAIN_TERRAIN 15
    terrain_cost VILLAGE_TERRAIN 15
}

