/* ice caves */
	/* caves do not have enough segments for larger maps than 240. */
	if MAPSIZE_TINY
		#const TILES_PER_CAVE_SEGMENT	10
	else
		#const TILES_PER_CAVE_SEGMENT	15
	endif
	if MAP_AT_LEAST_HUGE
		#define	SEVEN_SEGMENTS_PER_CAVE
		#define	AT_LEAST_SEVEN_SEGMENTS_PER_CAVE
		#define	AT_LEAST_SIX_SEGMENTS_PER_CAVE
		#define	AT_LEAST_FIVE_SEGMENTS_PER_CAVE
		#const		SEGMENTS_PER_CAVE	7
	elseif MAP_AT_LEAST_LARGE
		#define	SIX_SEGMENTS_PER_CAVE
		#define	AT_LEAST_SIX_SEGMENTS_PER_CAVE
		#define	AT_LEAST_FIVE_SEGMENTS_PER_CAVE
		#const		SEGMENTS_PER_CAVE	6
	elseif MAP_AT_LEAST_NORMAL
		#define	FIVE_SEGMENTS_PER_CAVE
		#define	AT_LEAST_FIVE_SEGMENTS_PER_CAVE
		#const		SEGMENTS_PER_CAVE	5
	else
		#define	FOUR_SEGMENTS_PER_CAVE
		#const		SEGMENTS_PER_CAVE	4
	endif
	#const BACK_CAVE_ELEVATION		2
	#const FRONT_CAVE_ELEVATION		1

	if SEVEN_SEGMENTS_PER_CAVE
		#const SEGMENT_THREE_NORMALIZER	(5 / 6)
		#const SEGMENT_FOUR_NORMALIZER	(4 / 5)
		#const SEGMENT_FIVE_NORMALIZER	(3 / 4)
		#const SEGMENT_SIX_NORMALIZER	(2 / 3)
		#const SEGMENT_SEVEN_NORMALIZER	(2 / 3)
	elseif SIX_SEGMENTS_PER_CAVE
		#const SEGMENT_THREE_NORMALIZER	(4 / 5)
		#const SEGMENT_FOUR_NORMALIZER	(3 / 4)
		#const SEGMENT_FIVE_NORMALIZER	(2 / 3)
		#const SEGMENT_SIX_NORMALIZER	(2 / 3)
		#const SEGMENT_SEVEN_NORMALIZER	1
	elseif FIVE_SEGMENTS_PER_CAVE
		#const SEGMENT_THREE_NORMALIZER	(3 / 4)
		#const SEGMENT_FOUR_NORMALIZER	(2 / 3)
		#const SEGMENT_FIVE_NORMALIZER	(2 / 3)
		#const SEGMENT_SIX_NORMALIZER	1
		#const SEGMENT_SEVEN_NORMALIZER	1
	else /* four_segments_per_cave */
		#const SEGMENT_THREE_NORMALIZER	(3 / 4)
		#const SEGMENT_FOUR_NORMALIZER	(2 / 3)
		#const SEGMENT_FIVE_NORMALIZER	1
		#const SEGMENT_SIX_NORMALIZER	1
		#const SEGMENT_SEVEN_NORMALIZER	1
	endif
	
	/* #const	CAVE_Y_TOP		(MAPSIZE * 0.01 - 11 * -1) */
	#const	CAVE_Y_TOP		10

	if MAP_AT_LEAST_HUGE
		#const CAVE_Y_SPACING	1.9
	elseif MAP_AT_LEAST_LARGE
		#const CAVE_Y_SPACING	2.1
	elseif MAP_AT_LEAST_NORMAL
		#const CAVE_Y_SPACING	2.5
	elseif MAP_AT_LEAST_MEDIUM
		#const CAVE_Y_SPACING	3.2
	else
		#const CAVE_Y_SPACING	3.5
	endif

	#const CAVE_SEGMENT_OFFSET_FACTOR	(MAPSIZE * 0.012)

	/* left cave */
		if FOUR_CAVES
			#const LEFT_CAVE_X	rnd(15,22)
			#const LEFT_CAVE_X_MIN	15
			#const LEFT_CAVE_X_MAX	22
		elseif THIRD_CAVE
			#const LEFT_CAVE_X	rnd(20,29)
			#const LEFT_CAVE_X_MIN	20
			#const LEFT_CAVE_X_MAX	29
		else
			#const LEFT_CAVE_X	rnd(25,35)
			#const LEFT_CAVE_X_MIN	25
			#const LEFT_CAVE_X_MAX	35
		endif

		#const LEFT_CAVE_FIRST_OFFSET	rnd(-4,4)
		#const LEFT_CAVE_SECOND_OFFSET	rnd(-4,4)
		#const LEFT_CAVE_THIRD_OFFSET	rnd(-4,4)
		#const LEFT_CAVE_FOURTH_OFFSET	rnd(-4,4)
		#const LEFT_CAVE_FIFTH_OFFSET	rnd(-4,4)
		#const LEFT_CAVE_SIXTH_OFFSET	rnd(-4,4)
		/* rework to adjust by segment count
			idea: replace normalizer values with set consts or math of segment count */
		#const LEFT_CAVE_SECOND_SEGMENT_X	(LEFT_CAVE_FIRST_OFFSET / CAVE_SEGMENT_OFFSET_FACTOR + LEFT_CAVE_X)
		#const LEFT_CAVE_THIRD_SEGMENT_X	(LEFT_CAVE_SECOND_OFFSET / CAVE_SEGMENT_OFFSET_FACTOR + LEFT_CAVE_SECOND_SEGMENT_X - LEFT_CAVE_X * SEGMENT_THREE_NORMALIZER + LEFT_CAVE_X)
		#const LEFT_CAVE_FOURTH_SEGMENT_X	(LEFT_CAVE_THIRD_OFFSET / CAVE_SEGMENT_OFFSET_FACTOR + LEFT_CAVE_THIRD_SEGMENT_X - LEFT_CAVE_X * SEGMENT_FOUR_NORMALIZER + LEFT_CAVE_X)
		#const LEFT_CAVE_FIFTH_SEGMENT_X	(LEFT_CAVE_FOURTH_OFFSET / CAVE_SEGMENT_OFFSET_FACTOR + LEFT_CAVE_FOURTH_SEGMENT_X - LEFT_CAVE_X * SEGMENT_FIVE_NORMALIZER + LEFT_CAVE_X)
		#const LEFT_CAVE_SIXTH_SEGMENT_X	(LEFT_CAVE_FIFTH_OFFSET / CAVE_SEGMENT_OFFSET_FACTOR + LEFT_CAVE_FIFTH_SEGMENT_X - LEFT_CAVE_X * SEGMENT_SIX_NORMALIZER + LEFT_CAVE_X)
