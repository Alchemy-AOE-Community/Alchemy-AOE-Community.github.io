				assign_to ASSIGN_TARGET PLAYER_COLOR_A 0 0
			elseif ASSIGN_AT_RANDOM 
				assign_to ASSIGN_TARGET -10 ASSIGN_MODE 0
			else
				assign_to ASSIGN_TARGET TEAM_A ASSIGN_MODE 0
			endif
