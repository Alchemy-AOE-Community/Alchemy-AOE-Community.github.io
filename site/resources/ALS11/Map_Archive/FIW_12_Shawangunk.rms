		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_M * -5 + MAPSIZE) ACT_A_DIVIDER_M ACT_R_DIVIDER_M
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_M * -7 + MAPSIZE) ACT_A_DIVIDER_M ACT_R_DIVIDER_M
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_M * -9 + MAPSIZE) ACT_A_DIVIDER_M ACT_R_DIVIDER_M
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_M * -11 + MAPSIZE) ACT_A_DIVIDER_M ACT_R_DIVIDER_M
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_M * -13 + MAPSIZE) ACT_A_DIVIDER_M ACT_R_DIVIDER_M

		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -1 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -3 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -5 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -7 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -9 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -11 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -13 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -15 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -17 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
		create_actor_area (MAPSIZE * 0.5) (ACT_R_DIVIDER_S * -19 + MAPSIZE) ACT_A_DIVIDER_S ACT_R_DIVIDER_S
	endif
	/* left right halves */
		create_actor_area (MAPSIZE * 0.245) (MAPSIZE * 0.25) ACT_A_LEFT_HALF ACT_R_LEFT_HALF
		create_actor_area (MAPSIZE * 0.245) (MAPSIZE * 0.75) ACT_A_LEFT_HALF ACT_R_LEFT_HALF
		create_actor_area (MAPSIZE * 0.755) (MAPSIZE * 0.25) ACT_A_RIGHT_HALF ACT_R_RIGHT_HALF
		create_actor_area (MAPSIZE * 0.755) (MAPSIZE * 0.75) ACT_A_RIGHT_HALF ACT_R_RIGHT_HALF
