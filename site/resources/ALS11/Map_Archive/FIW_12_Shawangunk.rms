/* mountains */
	
	#const MOUNTAIN_BASE_ELEVATION	3
	#const MOUNTAIN_BORDER_X_PADDING	8
	#const MOUNTAIN_TOP_BORDER		10
	#const MOUNTAIN_BOTTOM_BORDER		80
	if MAPSIZE_TINY
		#const MOUNTAIN_BORDER_FUZZINESS		30
	elseif MAPSIZE_SMALL
		#const MOUNTAIN_BORDER_FUZZINESS		20
	elseif MAPSIZE_MEDIUM
		#const MOUNTAIN_BORDER_FUZZINESS		18
	else
		#const MOUNTAIN_BORDER_FUZZINESS		16
	endif

	create_land
	{
		terrain_type	TERR_MOUNTAIN
		land_position		10 15
		land_percent		15
		/* left_border  0
		right_border  (100 - LEFT_CAVE_X - MOUNTAIN_BORDER_X_PADDING) */
		top_border		MOUNTAIN_TOP_BORDER
		bottom_border		MOUNTAIN_BOTTOM_BORDER
		border_fuzziness	MOUNTAIN_BORDER_FUZZINESS
		base_elevation	MOUNTAIN_BASE_ELEVATION
		zone 		ZONE_MOUNTAIN
		land_id	L_ID_MOUNTAINS
	}
	create_land
	{
		terrain_type	TERR_MOUNTAIN
		if AT_LEAST_4_CAVES
			land_position		29 15
		elseif AT_LEAST_3_CAVES
			land_position		38 15
		else
			land_position		50 15
		endif
		land_percent		15
		/* left_border  (LEFT_CAVE_X - MOUNTAIN_BORDER_X_PADDING)
		if AT_LEAST_3_CAVES
			right_border  (100 - THIRD_CAVE_X - MOUNTAIN_BORDER_X_PADDING)
		else
			right_border  (100 - RIGHT_CAVE_X - MOUNTAIN_BORDER_X_PADDING)
		endif */
		top_border		MOUNTAIN_TOP_BORDER
		bottom_border		MOUNTAIN_BOTTOM_BORDER
		border_fuzziness	MOUNTAIN_BORDER_FUZZINESS
		base_elevation	MOUNTAIN_BASE_ELEVATION
		zone 		ZONE_MOUNTAIN
		land_id	L_ID_MOUNTAINS
	}
	if AT_LEAST_3_CAVES
		create_land
		{
			terrain_type	TERR_MOUNTAIN
			if AT_LEAST_4_CAVES
				land_position		50 15
			else /* AT_LEAST_3_CAVES */
				land_position		62 15
			endif
			land_percent		15
