		percent_chance 33
			#const OBJ_HERDABLE_A	DLC_PIG
		percent_chance 33
			#const OBJ_HERDABLE_A	DLC_GOAT
		percent_chance 34
			#const OBJ_HERDABLE_A	SHEEP
		end_random
	start_random
		percent_chance 50
			#const OBJ_HERDABLE_B	TURKEY
		percent_chance 50
			#const OBJ_HERDABLE_B	DLC_GOOSE
		end_random
	/* Placeholder objects */
