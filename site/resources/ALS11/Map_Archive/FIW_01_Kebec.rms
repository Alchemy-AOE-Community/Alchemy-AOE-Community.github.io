#define ROAD_CONNECTIONS
if ROAD_CONNECTIONS
  
  start_random
    percent_chance 50 #const FC 4 #const SC 5
    percent_chance 50 #const FC 5 #const SC 4
  end_random
  
  /*
  /* Highway Terrains */
  #const HIGHWAY_BASE 38

  /* River Terrains */
  #const NN_BEACH_BASE  82
  #const NN_BEACH_MASK1 74
  #const NN_BEACH_MASK2 74
  #const NN_BEACH_MASK3 74
  #const NN_BEACH_MASK4 74

