  create_terrain RIV_MED_BASE { base_terrain RIV_COAST_BASE land_percent 100 number_of_clumps 9320 set_scale_by_groups spacing_to_other_terrain_types 1 }
  /* Masking */
  create_terrain RIV_MED_MASK1 { base_terrain RIV_MED_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  create_terrain RIV_MED_MASK2 { base_terrain RIV_MED_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  create_terrain RIV_MED_MASK3 { base_terrain RIV_MED_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  create_terrain RIV_MED_MASK4 { base_terrain RIV_MED_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }

  /* Water Deep Application */
  create_terrain RIV_DEEP_BASE { base_terrain RIV_MED_BASE land_percent 100 number_of_clumps 9320 set_scale_by_groups spacing_to_other_terrain_types 1 }
  /* Masking */
  create_terrain RIV_DEEP_MASK1 { base_terrain RIV_DEEP_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  create_terrain RIV_DEEP_MASK2 { base_terrain RIV_DEEP_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  create_terrain RIV_DEEP_MASK3 { base_terrain RIV_DEEP_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  create_terrain RIV_DEEP_MASK4 { base_terrain RIV_DEEP_BASE land_percent 1 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }

  if WINTER_SEASON
    create_terrain WNB { base_terrain RIV_DEEP_BASE number_of_tiles 1 number_of_clumps 60 set_scale_by_groups }
    create_terrain RIV_DEEP_MASK3 { base_terrain WNB land_percent 100 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  elseif SPRING_SEASON
    create_terrain ICE { base_terrain RIV_DEEP_BASE  land_percent 100 number_of_clumps 9320 set_scale_by_groups if TINY_MAP spacing_to_specific_terrain PHT4 34 elseif SMALL_MAP spacing_to_specific_terrain PHT4 41 elseif MEDIUM_MAP spacing_to_specific_terrain PHT4 48 elseif LARGE_MAP spacing_to_specific_terrain PHT4 57 elseif HUGE_MAP spacing_to_specific_terrain PHT4 62 else spacing_to_specific_terrain PHT4 68 endif }
    create_terrain ICE { base_terrain RIV_MED_BASE   land_percent 100 number_of_clumps 9320 set_scale_by_groups if TINY_MAP spacing_to_specific_terrain PHT4 34 elseif SMALL_MAP spacing_to_specific_terrain PHT4 41 elseif MEDIUM_MAP spacing_to_specific_terrain PHT4 48 elseif LARGE_MAP spacing_to_specific_terrain PHT4 57 elseif HUGE_MAP spacing_to_specific_terrain PHT4 62 else spacing_to_specific_terrain PHT4 68 endif }
    create_terrain ICE { base_terrain RIV_COAST_BASE land_percent 100 number_of_clumps 9320 set_scale_by_groups if TINY_MAP spacing_to_specific_terrain PHT4 34 elseif SMALL_MAP spacing_to_specific_terrain PHT4 41 elseif MEDIUM_MAP spacing_to_specific_terrain PHT4 48 elseif LARGE_MAP spacing_to_specific_terrain PHT4 57 elseif HUGE_MAP spacing_to_specific_terrain PHT4 62 else spacing_to_specific_terrain PHT4 68 endif }
    create_terrain WNB { base_terrain ICE number_of_tiles 1 number_of_clumps 30 set_scale_by_groups }
    create_terrain RIV_DEEP_MASK3 { base_terrain WNB land_percent 100 number_of_clumps 9320 set_scale_by_groups terrain_mask 1 }
  endif

endif

