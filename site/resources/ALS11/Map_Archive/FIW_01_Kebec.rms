  #const PLAINS_CAP 100
  #const PLAINS_MASK1 74
  #const PLAINS_MASK2 35
  #const PLAINS_MASK3 74
  #const PLAINS_MASK4 74
  */
  
  accumulate_connections
  create_connect_land_zones 2 FC
  {
    default_terrain_replacement HIGHWAY_BASE
    terrain_cost  PLAINS_BASE      6
    terrain_cost  PLAINS_CAP       6
    terrain_cost  CITY_ROAD_BASE      6
    terrain_cost  CITY_BLOCK_BASE     -1
    terrain_cost  PLAINS_FOREST_BASE  15 
    terrain_cost  CITY_WALL_BASE      25
    terrain_cost  CITY_PARK_BASE      20 
    terrain_cost  CITY_FOREST_BASE    -1    
    terrain_cost  CLIFF_TOP_BASE      20
    terrain_cost  CLIFF_MED_BASE      -1
    terrain_cost  CLIFF_LOW_BASE      -1
  }
  create_connect_land_zones 2 SC
  {
    default_terrain_replacement HIGHWAY_BASE
    terrain_cost  PLAINS_BASE      6
    terrain_cost  PLAINS_CAP       6    
    terrain_cost  CITY_ROAD_BASE      6
